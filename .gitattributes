# Set default line endings to LF for cross-platform C development
* text=auto eol=lf

# Shell scripts must always use LF line endings
*.sh text eol=lf

# Batch and PowerShell scripts can use CRLF or LF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.xlsx binary
*.db binary
*.a binary
*.lib binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
